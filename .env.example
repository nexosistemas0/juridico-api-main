# Use o pooler Supavisor ou a conexão PostgreSQL do projeto juridico.
# Configure TLS com certificado válido; nunca use rejectUnauthorized:false.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
APP_ORIGIN=http://localhost:5173
PORT=3333
NODE_ENV=development
# Obrigatória para consultar DataJud: copie a chave pública atual da página oficial CNJ.
DATAJUD_API_KEY=
# Defina apenas conforme a topologia do proxy, por exemplo 1 no Render.
TRUST_PROXY_HOPS=

# Opcional: servir o frontend compilado na mesma origem da API.
FRONTEND_DIST=../juridico-app/web/dist

# URL pública do portal web que recebe o link de assinatura. HTTPS em produção.
PUBLIC_WEB_URL=http://localhost:5173
# E-mails: chave privada Resend e remetente de domínio verificado. Somente no servidor.
RESEND_API_KEY=
MAIL_FROM=
