# Use o pooler Supavisor ou a conexão PostgreSQL do projeto juridico.
# Configure TLS com certificado válido; nunca use rejectUnauthorized:false.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
APP_ORIGIN=http://localhost:5173
PORT=3333
NODE_ENV=development
# Opcional: substitui a chave PÚBLICA publicada pelo CNJ.
DATAJUD_API_KEY=
# Defina apenas conforme a topologia do proxy, por exemplo 1 no Render.
TRUST_PROXY_HOPS=

# Opcional: servir o frontend compilado na mesma origem da API.
FRONTEND_DIST=../juridico-app/dist
